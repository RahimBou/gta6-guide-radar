{
  "expo": {
    "name": "GTA 6 Guide Radar",
    "slug": "gta6-guide-radar",
    "scheme": "gta6radar",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rahimbou.gta6guideradar"
    },
    "android": {
      "package": "com.rahimbou.gta6guideradar",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ]
    },
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true }
  }
}
